# Игнорируем временные файлы редакторов
.DS_Store
*.swp
*.swo
*~
*.bak
*.tmp

# Игнорируем папки зависимостей
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Игнорируем скомпилированные/бинарные файлы
*.exe
*.dll
*.so
*.dylib
*.class
*.out

# Игнорируем системные файлы
Thumbs.db
ehthumbs.db
Desktop.ini

# Игнорируем файлы IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Игнорируем логи и временные данные
logs/
*.log

# Игнорируем папки сборки
dist/
build/
out/
*.zip
*.tar.gz

# Игнорируем тестовые файлы (если не нужны в репозитории)
coverage/
*.lcov

# Игнорируем конфиденциальные данные
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json

# Игнорируем пользовательские тестовые файлы (например, созданные для проверки)
analyze.js
fragment.html
